<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:stretchColumns="1"> <!-- 拉伸第2列填满屏幕 -->

    <TableRow>
        <TextView
            android:text="Open"
            android:padding="8dp" />
        <TextView
            android:text="Ctrl+N"
            android:gravity="end"
            android:padding="8dp" />
    </TableRow>

    <TableRow>
        <TextView
            android:text="Save"
            android:padding="8dp" />
        <TextView
            android:text="Ctrl+O"
            android:gravity="end"
            android:padding="8dp" />
    </TableRow>

    <TableRow>
        <TextView
            android:text="Save As"
            android:padding="8dp" />
        <TextView
            android:text="Ctrl+S"
            android:gravity="end"
            android:padding="8dp" />
    </TableRow>

    <!-- 分割线 -->
    <View
        android:layout_height="1dp"
        android:background="#CCCCCC" />

    <TableRow>
        <TextView
            android:text="Save As"
            android:padding="8dp" />
        <TextView
            android:text="Ctrl+S"
            android:gravity="end"
            android:padding="8dp" />
    </TableRow>

    <TableRow>
        <TextView
            android:text="Import"
            android:padding="8dp" />
        <TextView
            android:text=""
            android:gravity="end"
            android:padding="8dp" />
    </TableRow>

    <TableRow>
        <TextView
            android:text="Export"
            android:padding="8dp" />
        <TextView
            android:text="Ctrl+E"
            android:gravity="end"
            android:padding="8dp" />
    </TableRow>

    <!-- 分割线 -->
    <View
        android:layout_height="1dp"
        android:background="#CCCCCC" />

    <TableRow>
        <TextView
            android:text="Quit"
            android:padding="8dp" />
        <TextView
            android:text=""
            android:gravity="end"
            android:padding="8dp" />
    </TableRow>
</TableLayout>